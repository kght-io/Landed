{
  "name": "@landed/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "The Electron shell. A window onto the app (wherever it runs) plus the capabilities a browser cannot offer: revealing folders and reading files on the machine the r\u00e9sum\u00e9s actually live on.",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --target=node20 --format=cjs --outdir=dist --external:electron --sourcemap && node -e \"require('fs').cpSync('src/renderer','dist/renderer',{recursive:true})\"",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
