{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@landed/core/db": ["./packages/core/src/db/index.ts"],
      "@landed/core/*": ["./packages/core/src/*"],
      "@landed/shared/*": ["./packages/shared/src/*"],
      "@/*": ["./apps/web/*"]
    }
  }
}
