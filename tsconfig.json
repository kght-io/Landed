{
  // The repo-wide typecheck gate: `npm run typecheck` compiles EVERY workspace plus tests and
  // scripts in one pass, so a break anywhere (web ⇄ core ⇄ shared) surfaces in one command.
  // apps/web/tsconfig.json exists separately for Next.js and the editor; this file is the gate.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "apps/web/next-env.d.ts",
    "apps/web/**/*.ts",
    "apps/web/**/*.tsx",
    "apps/web/.next/types/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "**/node_modules"]
}
