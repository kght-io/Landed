# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + every workspace)
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (the app lives in frontend now)
/frontend/.next/
/frontend/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
frontend/next-env.d.ts

# local sqlite db
/data/

# the default ASSET_ROOT (.env.example) — your résumés, transcripts, and interview
# notes. Personal data; this repo is public.
/asset-root/

# Machine-specific local serving config (hardcoded absolute paths — not portable)
/scripts/landed.Caddyfile
/scripts/com.kaung.landed-proxy.plist

# Claude Code local (personal, uncommitted) settings
.claude/settings.local.json
